BOT_TOKEN=
ADMIN_ID=
ALLOWED_USERS=
# Прокси (HTTP или SOCKS5) для доступа к Telegram API и облачным LLM (Google Gemini, OpenAI).
# Поддерживаются форматы:
#   http://user:password@ip:port
#   socks5://user:password@ip:port
#   http://ip:port
#   ip:port:user:password
PROXY_URL=
REDIS_URL=

# S3 Configuration (SeaweedFS / MinIO / AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=obsidian
OBSIDIAN_VAULT_NAME=Notes
S3_SYNC_CONCURRENCY=5

# ==========================================
# Pluggable AI Configuration (LLM)
# ==========================================
# Модель ИИ: можно указать абсолютно любую модель, которую поддерживает выбранный провайдер.
# Примеры:
#   Google Gemini: gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro, gemini-2.0-flash
#   OpenAI: gpt-4o-mini, gpt-4o, o3-mini
#   DeepSeek: deepseek-chat, deepseek-reasoner
#   Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768
#   Ollama: llama3:8b, qwen2.5:7b, mistral
# Если оставить пустым, используется рекомендуемая модель по умолчанию для провайдера.
AI_MODEL=

# Поддерживаемые провайдеры: gemini, openai, groq, deepseek, openrouter, ollama, custom
# Оставьте auto для автоматического определения провайдера по указанному API-ключу.
AI_PROVIDER=auto

# 1. Google Gemini (Бесплатный ключ на https://aistudio.google.com/)
# Официальные модели Google:
#   gemini-2.5-flash (по умолчанию, рекомендуемая)
#   gemini-2.0-flash
#   gemini-2.0-flash-lite
#   gemini-1.5-flash
#   gemini-1.5-pro
# (Не используйте несуществующие имена вроде gemini-3.5-flash-lite)
GEMINI_API_KEY=

# 2. OpenAI (Модель по умолчанию: gpt-4o-mini, или задайте в AI_MODEL=)
OPENAI_API_KEY=

# 3. DeepSeek (Модель по умолчанию: deepseek-chat, или задайте в AI_MODEL=)
DEEPSEEK_API_KEY=

# 4. OpenRouter (мульти-модельный шлюз, модель по умолчанию: google/gemini-2.5-flash)
OPENROUTER_API_KEY=

# 5. Кастомный сервер / Локальная Ollama / Шлюз (если не используются облачные провайдеры)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama

# Audio Transcription (Groq Whisper)
# Бесплатный ключ на https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# Database & Runtime
DB_PATH=database.db
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
LOG_FILE=bot_log.log