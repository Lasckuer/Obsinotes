BOT_TOKEN=
ADMIN_ID=
ALLOWED_USERS=
PROXY_URL=
REDIS_URL=

# S3 Configuration (SeaweedFS / MinIO / AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=obsidian
OBSIDIAN_VAULT_NAME=Notes
S3_SYNC_CONCURRENCY=5

# ==========================================
# Pluggable AI Configuration (LLM)
# ==========================================
# Supported providers: gemini, openai, groq, deepseek, openrouter, ollama, custom
# Leave AI_PROVIDER=auto to automatically detect provider based on provided API keys.
AI_PROVIDER=auto

# 1. Google Gemini (Бесплатный ключ на https://aistudio.google.com/)
# При указании GEMINI_API_KEY бот автоматически использует модель gemini-2.5-flash
GEMINI_API_KEY=

# 2. OpenAI (GPT-4o-mini)
OPENAI_API_KEY=

# 3. DeepSeek (deepseek-chat)
DEEPSEEK_API_KEY=

# 4. OpenRouter (мульти-модельный шлюз)
OPENROUTER_API_KEY=

# 5. Кастомный сервер / Локальная Ollama / Шлюз (если не используются облачные провайдеры)
# AI_BASE_URL=https://api-ai.lkserv.ru/v1
# AI_API_KEY=ollama
# AI_MODEL=gemma4:e2b

# Audio Transcription (Groq Whisper)
# Бесплатный ключ на https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# Database & Runtime
DB_PATH=database.db
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
LOG_FILE=bot_log.log